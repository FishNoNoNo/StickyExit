# ========== 代理分发系统配置模板 ==========
# 复制为 .env 后按需修改，重启 python main.py 生效
# 所有项均可省略，省略时使用代码内置默认值

# 对外代理监听（HTTP+SOCKS5 同端口）
LISTEN_IP=0.0.0.0
LISTEN_PORT=1080

# Web 管理页监听
WEB_HOST=0.0.0.0
WEB_PORT=5003

# Web 管理页访问口令：留空=不认证；设置后打开页面需要 ?token=密码，所有 /api/* 接口也需携带
WEB_ADMIN_TOKEN=

# 展示给用户的对外 IP（代理地址里的 host）
# 留空自动探测：LISTEN_IP 具体值 > 公网 IP > 本机内网 IP
# 服务器有公网 IP 建议直接填，避免探测不准
ADVERTISE_IP=

# 拉取订阅是否校验证书：机场面板多是自签名证书，默认 0 不校验
VERIFY_SSL=0

# 手动检测节点时的 TCP 拨测超时（秒）
NODE_CHECK_TIMEOUT=5.0

# ---------- Clash API（sing-box 运行时控制）----------
# 只应绑定回环地址；暴露出去等于把节点切换权交给任何人。
CLASH_API_HOST=127.0.0.1
CLASH_API_PORT=9090
CLASH_API_SECRET=

# ---------- 节点池健康探测与降级/回切 ----------
# 只探测进入用户节点池的节点；连续失败达阈值后降级，恢复达阈值后回切。
HEALTH_INTERVAL=30
# 健康探测每轮最大并发数（协程，池节点很多时可放心调大）
HEALTH_MAX_WORKERS=20
FAIL_THRESHOLD=3
RECOVER_THRESHOLD=2
HEALTH_PROBE_URL=http://www.gstatic.com/generate_204
HEALTH_PROBE_TIMEOUT=5.0
